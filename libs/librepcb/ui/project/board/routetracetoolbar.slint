import {
    ComboBox,
    LengthEdit,
    ToolBarButton,
    ToolBarSelectorButton,
    ToolBarWidget,
} from "../../widgets.slint";
import {
    Backend,
    Board2dTabData,
    RouterMode,
    RouterTuningMode,
    TabAction,
    WindowSectionData,
} from "../../api.slint";

// Toolbar of the push & shove router.
//
// The first four widgets are the ones the draw trace toolbar has too, bound
// to the same generic tool properties. The router-specific ones follow:
// the routing mode, the corner mode, the posture, the via placement, the
// differential pair switch with the three pair sizes it reveals, and the
// length tuning mode with the five meander dimensions it reveals.
export component RouteTraceToolBar inherits HorizontalLayout {
    in property <int> section-index;
    in-out property <WindowSectionData> section;
    in property <bool> show-via-size: true;
    property <[Board2dTabData]> tabs: section.board-2d-tabs;

    spacing: 2px;

    layer-cbx := ComboBox {
        model: tabs[section.current-tab-index].tool-layer.items;
        current-index: tabs[section.current-tab-index].tool-layer.current-index;

        current-index-changed(index) => {
            tabs[section.current-tab-index].tool-layer.current-index = index;
        }
    }

    line-width-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-line-width;
        icon: @image-url("../../../../bootstrap-icons/icons/border-width.svg");
        tooltip: @tr("Trace Width");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-line-width.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-line-width.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-line-width.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-line-width.decrease = true;
        }
    }

    via-drill-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-drill;
        icon: @image-url("../../../../font-awesome/svgs/solid/bore-hole.svg");
        tooltip: @tr("Via Drill Diameter");
        min-width-text: "1.234";
        auto-supported: true;
        auto-checked: tabs[section.current-tab-index].tool-pressfit;

        value-changed(v) => {
            tabs[section.current-tab-index].tool-pressfit = false;
            tabs[section.current-tab-index].tool-drill.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-drill.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-pressfit = false;
            tabs[section.current-tab-index].tool-drill.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-pressfit = false;
            tabs[section.current-tab-index].tool-drill.decrease = true;
        }

        auto-toggled(checked) => {
            tabs[section.current-tab-index].tool-pressfit = checked;
        }
    }

    if show-via-size: via-size-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-size;
        icon: @image-url("../../../../bootstrap-icons/icons/record-circle-fill.svg");
        tooltip: @tr("Via Outer Diameter");
        min-width-text: "1.234";
        auto-supported: true;
        auto-checked: tabs[section.current-tab-index].tool-mirrored;
        enabled: !via-drill-edt.auto-checked;

        value-changed(v) => {
            tabs[section.current-tab-index].tool-mirrored = false;
            tabs[section.current-tab-index].tool-size.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-size.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-mirrored = false;
            tabs[section.current-tab-index].tool-size.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-mirrored = false;
            tabs[section.current-tab-index].tool-size.decrease = true;
        }

        auto-toggled(checked) => {
            tabs[section.current-tab-index].tool-mirrored = checked;
        }
    }

    mode-selector := ToolBarWidget {
        ToolBarSelectorButton {
            icon: @image-url("../../../../font-awesome/svgs/solid/road-barrier.svg");
            tooltip: @tr("Mark Obstacles");
            status-tip: @tr("Routing mode: Route straight through and highlight what collides");
            checked: tabs[section.current-tab-index].tool-router-mode == RouterMode.mark-obstacles;

            clicked => {
                tabs[section.current-tab-index].tool-router-mode = RouterMode.mark-obstacles;
            }
        }

        ToolBarSelectorButton {
            icon: @image-url("../../../../bootstrap-icons/icons/sign-turn-slight-right.svg");
            tooltip: @tr("Walk Around");
            status-tip: @tr("Routing mode: Bend the trace around whatever is in the way");
            checked: tabs[section.current-tab-index].tool-router-mode == RouterMode.walkaround;

            clicked => {
                tabs[section.current-tab-index].tool-router-mode = RouterMode.walkaround;
            }
        }

        ToolBarSelectorButton {
            icon: @image-url("../../../../font-awesome/svgs/solid/arrows-left-right.svg");
            tooltip: @tr("Shove");
            status-tip: @tr("Routing mode: Push colliding traces and vias aside");
            checked: tabs[section.current-tab-index].tool-router-mode == RouterMode.shove;

            clicked => {
                tabs[section.current-tab-index].tool-router-mode = RouterMode.shove;
            }
        }
    }

    corner-mode-sw := ToolBarButton {
        icon: @image-url("../../../../../img/command_toolbars/wire_h_v.png");
        tooltip: @tr("90° Corners");
        status-tip: @tr("Build the trace from horizontal and vertical segments only");
        checked: tabs[section.current-tab-index].tool-router-corner-mode;
        checkable: true;

        clicked => {
            tabs[section.current-tab-index].tool-router-corner-mode = !self.checked;
        }
    }

    flip-posture-btn := ToolBarButton {
        icon: @image-url("../../../../font-awesome/svgs/solid/arrow-right-arrow-left.svg");
        tooltip: @tr("Flip Posture");
        status-tip: @tr("Turn the routed trace's first corner the other way");

        clicked => {
            Backend.trigger-tab(section-index, section.current-tab-index, TabAction.router-flip-posture);
        }
    }

    via-toggle-btn := ToolBarButton {
        icon: @image-url("../../../../../img/via.svg");
        tooltip: @tr("Toggle Via Placement");
        status-tip: @tr("Place a via where the routed trace is fixed next");

        clicked => {
            Backend.trigger-tab(section-index, section.current-tab-index, TabAction.router-via-toggle);
        }
    }

    diff-pair-sw := ToolBarButton {
        icon: @image-url("../../../../font-awesome/svgs/solid/equals.svg");
        tooltip: @tr("Differential Pair");
        status-tip: @tr("Route both nets of a differential pair at once");
        checked: tabs[section.current-tab-index].tool-router-diff-pair;
        checkable: true;

        clicked => {
            tabs[section.current-tab-index].tool-router-diff-pair = !self.checked;
        }
    }

    // The three pair sizes only make sense while pairs are being routed, and
    // the toolbar is crowded enough without them.
    if diff-pair-sw.checked: diff-pair-width-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-diff-pair-width;
        icon: @image-url("../../../../bootstrap-icons/icons/border-width.svg");
        tooltip: @tr("Differential Pair Trace Width");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-diff-pair-width.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-diff-pair-width.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-width.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-width.decrease = true;
        }
    }

    if diff-pair-sw.checked: diff-pair-gap-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-diff-pair-gap;
        icon: @image-url("../../../../bootstrap-icons/icons/distribute-horizontal.svg");
        tooltip: @tr("Differential Pair Gap");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-diff-pair-gap.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-diff-pair-gap.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-gap.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-gap.decrease = true;
        }
    }

    // "Auto" here means "the same as the trace gap", which is what the
    // router's own via gap switch does.
    if diff-pair-sw.checked && show-via-size: diff-pair-via-gap-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-diff-pair-via-gap;
        icon: @image-url("../../../../bootstrap-icons/icons/record-circle-fill.svg");
        tooltip: @tr("Differential Pair Via Gap");
        min-width-text: "1.234";
        auto-supported: true;
        auto-checked: tabs[section.current-tab-index].tool-diff-pair-via-gap-auto;

        value-changed(v) => {
            tabs[section.current-tab-index].tool-diff-pair-via-gap-auto = false;
            tabs[section.current-tab-index].tool-diff-pair-via-gap.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-diff-pair-via-gap.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-via-gap-auto = false;
            tabs[section.current-tab-index].tool-diff-pair-via-gap.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-diff-pair-via-gap-auto = false;
            tabs[section.current-tab-index].tool-diff-pair-via-gap.decrease = true;
        }

        auto-toggled(checked) => {
            tabs[section.current-tab-index].tool-diff-pair-via-gap-auto = checked;
        }
    }

    // Off is the routing tool; any other value makes a press on a trace
    // start a length tuning session instead of a route or a drag. Clicking
    // the checked button turns the selector back off, which is what keeps
    // four values in three buttons.
    tuning-selector := ToolBarWidget {
        ToolBarSelectorButton {
            icon: @image-url("../../../../font-awesome/svgs/solid/ruler-horizontal.svg");
            tooltip: @tr("Tune Trace Length");
            status-tip: @tr("Length tuning: Meander one trace up to a target length");
            checked: tabs[section.current-tab-index].tool-router-tuning-mode == RouterTuningMode.single;

            clicked => {
                tabs[section.current-tab-index].tool-router-tuning-mode = self.checked ? RouterTuningMode.off : RouterTuningMode.single;
            }
        }

        ToolBarSelectorButton {
            icon: @image-url("../../../../font-awesome/svgs/solid/ruler-combined.svg");
            tooltip: @tr("Tune Differential Pair Length");
            status-tip: @tr("Length tuning: Meander both traces of a differential pair up to a target length");
            checked: tabs[section.current-tab-index].tool-router-tuning-mode == RouterTuningMode.diff-pair;

            clicked => {
                tabs[section.current-tab-index].tool-router-tuning-mode = self.checked ? RouterTuningMode.off : RouterTuningMode.diff-pair;
            }
        }

        ToolBarSelectorButton {
            icon: @image-url("../../../../font-awesome/svgs/solid/scale-balanced.svg");
            tooltip: @tr("Tune Differential Pair Skew");
            status-tip: @tr("Length tuning: Meander the clicked trace of a differential pair until the two match");
            checked: tabs[section.current-tab-index].tool-router-tuning-mode == RouterTuningMode.skew;

            clicked => {
                tabs[section.current-tab-index].tool-router-tuning-mode = self.checked ? RouterTuningMode.off : RouterTuningMode.skew;
            }
        }
    }

    // The five meander dimensions only make sense while a tuning mode is
    // on, and the toolbar is crowded enough without them.
    property <bool> tuning: tabs[section.current-tab-index].tool-router-tuning-mode != RouterTuningMode.off;
    property <bool> skew: tabs[section.current-tab-index].tool-router-tuning-mode == RouterTuningMode.skew;

    // The target is a length in the two length modes and a skew in the skew
    // mode, because that is the field the router reads in each of them.
    if tuning: tuning-target-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-tuning-target;
        icon: @image-url("../../../../bootstrap-icons/icons/rulers.svg");
        tooltip: skew ? @tr("Target Skew") : @tr("Target Length");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-tuning-target.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-tuning-target.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-tuning-target.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-tuning-target.decrease = true;
        }
    }

    if tuning: tuning-tolerance-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-tuning-tolerance;
        icon: @image-url("../../../../font-awesome/svgs/solid/plus-minus.svg");
        tooltip: @tr("Target Tolerance");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-tuning-tolerance.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-tuning-tolerance.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-tuning-tolerance.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-tuning-tolerance.decrease = true;
        }
    }

    if tuning: tuning-min-amplitude-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-tuning-min-amplitude;
        icon: @image-url("../../../../bootstrap-icons/icons/arrows-collapse.svg");
        tooltip: @tr("Minimum Meander Amplitude");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-tuning-min-amplitude.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-tuning-min-amplitude.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-tuning-min-amplitude.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-tuning-min-amplitude.decrease = true;
        }
    }

    if tuning: tuning-max-amplitude-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-tuning-max-amplitude;
        icon: @image-url("../../../../bootstrap-icons/icons/arrows-expand.svg");
        tooltip: @tr("Maximum Meander Amplitude");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-tuning-max-amplitude.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-tuning-max-amplitude.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-tuning-max-amplitude.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-tuning-max-amplitude.decrease = true;
        }
    }

    if tuning: tuning-spacing-edt := LengthEdit {
        data: tabs[section.current-tab-index].tool-tuning-spacing;
        icon: @image-url("../../../../bootstrap-icons/icons/distribute-horizontal.svg");
        tooltip: @tr("Meander Spacing");
        min-width-text: "1.234";

        value-changed(v) => {
            tabs[section.current-tab-index].tool-tuning-spacing.value = v;
        }

        unit-changed(u) => {
            tabs[section.current-tab-index].tool-tuning-spacing.unit = u;
        }

        increase-triggered => {
            tabs[section.current-tab-index].tool-tuning-spacing.increase = true;
        }

        decrease-triggered => {
            tabs[section.current-tab-index].tool-tuning-spacing.decrease = true;
        }
    }
}
